<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>Multiple Enclosures</title>
    <item>
      <title>Missing URL Does Not Clear Audio</title>
      <guid>missing-url</guid>
      <enclosure url="https://example.com/first.mp3" type="audio/mpeg" />
      <enclosure type="audio/mpeg" />
    </item>
    <item>
      <title>Audio Replaces Image</title>
      <guid>image-then-audio</guid>
      <enclosure url="https://example.com/cover.jpg" type="image/jpeg" />
      <enclosure url="https://example.com/second.mp3" type="audio/mpeg" />
    </item>
    <item>
      <title>Image Does Not Replace Audio</title>
      <guid>audio-then-image</guid>
      <enclosure url="https://example.com/third.mp3" type="audio/mpeg" />
      <enclosure url="https://example.com/transcript.pdf" type="application/pdf" />
    </item>
  </channel>
</rss>
