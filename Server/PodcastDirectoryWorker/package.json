{
  "name": "opencast-podcast-directory-worker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "deploy:dry-run:prod-staging": "wrangler deploy --dry-run --outdir dist-prod-staging --env prod-staging",
    "deploy:dry-run:production": "wrangler deploy --dry-run --outdir dist-production --env production",
    "deploy": "wrangler deploy",
    "deploy:prod-staging": "wrangler deploy --env prod-staging",
    "deploy:production": "wrangler deploy --env production",
    "login": "wrangler login",
    "test": "cargo test",
    "typecheck": "cargo check --target wasm32-unknown-unknown --lib",
    "build:worker": "cargo install -q --locked \"worker-build@0.8.5\" && \"$HOME/.cargo/bin/worker-build\" --release",
    "test:integration": "yarn run build:worker && vitest run && vitest run --config vitest.killswitch.config.mjs && vitest run --config vitest.nosecrets.config.mjs",
    "provision": "scripts/provision-secrets.sh"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
