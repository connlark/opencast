// Public self-hosting template for the isolated prod-staging media worker.
// Its container reads through this worker's own R2 binding. Deploy with:
//   yarn deploy:prod-staging
// It has no routes or workers.dev exposure.
{
  "name": "your-transcription-media-worker-prod-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "workers_dev": false,
  "observability": { "enabled": true },
  // Replace every marker and pin the digest of your pushed image.
  "containers": [
    {
      "class_name": "TranscriptionMediaContainer",
      "image": "registry.cloudflare.com/REPLACE_WITH_ACCOUNT_HASH/your-transcription-media-container:REPLACE_WITH_TAG@sha256:REPLACE_WITH_IMAGE_DIGEST",
      "max_instances": 2,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MEDIA_CONTAINER",
        "class_name": "TranscriptionMediaContainer"
      }
    ]
  },
  // Declarative class exports (replaces the legacy migrations array). This map
  // is the source of truth: a class missing here is deprovisioned, not ignored.
  "exports": {
    "TranscriptionMediaContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "r2_buckets": [
    {
      "binding": "TRANSCRIPTION_AUDIO",
      "bucket_name": "your-remote-transcription-audio-prod-staging"
    }
  ]
}
