{
  "name": "opencast-transcription-media-worker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "deploy": "WRANGLER_DOCKER_BIN=\"$(command -v podman)\" wrangler deploy",
    "deploy:production": "wrangler deploy -c wrangler.production.jsonc",
    "login": "wrangler login",
    "typecheck": "tsc --noEmit",
    "build:image": "podman build -t your-transcription-media-container:dev container"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "typescript": "^5.6.0",
    "wrangler": "4.111.0"
  },
  "packageManager": "yarn@1.22.22"
}
