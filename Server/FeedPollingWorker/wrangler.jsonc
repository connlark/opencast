{
  // Public self-hosting template. Replace every REPLACE_WITH_* value and every
  // "your-*" name with resources from your own Cloudflare account, and keep the
  // queue names exactly as they are: the notifications Worker's queue ingress
  // compares each message against opencast-notification-<kind>-<lane> and
  // rejects anything else.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "main": "adapter/index.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "enable_request_signal"
  ],
  "limits": {
    "cpu_ms": 300000
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "build": {
    "command": "cargo install -q --locked \"worker-build@0.8.7\" && \"$HOME/.cargo/bin/worker-build\" --release"
  },
  "name": "your-feed-polling-worker",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "NOTIFICATION_ENVIRONMENT": "development",
    // Storage is PostgreSQL through DB; an absent authority is refused.
    "STORAGE_AUTHORITY": "postgres",
    // Both these vars and the matching n_control rows must allow an operation.
    // Leave every switch closed until your PostgreSQL, R2, Queues and the notifications
    // Worker are provisioned, migrated and reachable.
    "NOTIFICATION_DISPATCHER_ADMISSION": "false",
    "NOTIFICATION_FEED_OBSERVATION": "false",
    "NOTIFICATION_FIVE_MINUTE_POLLING": "false",
    "NOTIFICATION_CLEANUP": "false"
  },
  "triggers": {
    // The dispatcher runs on a one-minute cron and cleanup on a separate
    // two-minute cron. Enable them with ["* * * * *", "*/2 * * * *"] only after
    // App Attest, APNs, the PostgreSQL schema, the Queues and your abuse controls are
    // configured and the n_control rows are deliberately opened.
    "crons": []
  },
  // Development storage: `wrangler dev` reaches the local test topology
  // (NotificationsWorker/postgres/local/local-postgres.sh up) on its
  // opencast_dev clone as the runtime role. The all-zero id is a local
  // placeholder: create a Hyperdrive configuration for the notifications
  // lane's database before deploying this lane.
  "hyperdrive": [
    {
      "binding": "DB",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgresql://opencast_local_runtime:opencast-local-runtime@127.0.0.1:55432/opencast_dev?sslmode=disable"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FEED_SNAPSHOTS",
      // Private immutable feed history. Keep R2's default rule that aborts
      // incomplete multipart uploads after seven days.
      "bucket_name": "your-feed-snapshots"
    }
  ],
  "services": [
    {
      "binding": "NOTIFICATION_EVENTS",
      "service": "your-notifications-worker",
      "entrypoint": "FeedEvents"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "POLL_QUEUE",
        "queue": "opencast-notification-poll-development"
      }
    ],
    "consumers": [
      {
        "queue": "opencast-notification-poll-development",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 2,
        "max_retries": 3,
        "retry_delay": 60,
        "dead_letter_queue": "opencast-notification-poll-development-dlq"
      },
      {
        "queue": "opencast-notification-poll-development-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 1
      }
    ]
  },
  "env": {
    "prod-staging": {
      "name": "your-feed-polling-worker-prod-staging",
      "workers_dev": false,
      "preview_urls": false,
      "build": {
        "command": "cargo install -q --locked \"worker-build@0.8.7\" && \"$HOME/.cargo/bin/worker-build\" --release"
      },
      "vars": {
        "NOTIFICATION_ENVIRONMENT": "prod-staging",
        // Storage lives in PostgreSQL through the DB Hyperdrive binding. Set the pin
        // to your database's identity, or delete it for an ungated deployment; the
        // REPLACE_WITH_* placeholder does not parse, so an unedited lane refuses
        // every storage call and writes nothing.
        "STORAGE_AUTHORITY": "postgres",
        "STORAGE_IDENTITY": "v1;prod-staging;postgres;pg:REPLACE_WITH_DATABASE_NAME:REPLACE_WITH_SYSTEM_IDENTIFIER",
        "NOTIFICATION_DISPATCHER_ADMISSION": "false",
        "NOTIFICATION_FEED_OBSERVATION": "false",
        "NOTIFICATION_FIVE_MINUTE_POLLING": "false",
        "NOTIFICATION_CLEANUP": "false"
      },
      "triggers": {
        "crons": []
      },
      "hyperdrive": [
        {
          "binding": "DB",
          "id": "REPLACE_WITH_PROD_STAGING_HYPERDRIVE_ID"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FEED_SNAPSHOTS",
          "bucket_name": "your-feed-snapshots-prod-staging"
        }
      ],
      "services": [
        {
          "binding": "NOTIFICATION_EVENTS",
          "service": "your-notifications-worker-prod-staging",
          "entrypoint": "FeedEvents"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "POLL_QUEUE",
            "queue": "opencast-notification-poll-prod-staging"
          }
        ],
        "consumers": [
          {
            "queue": "opencast-notification-poll-prod-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_concurrency": 2,
            "max_retries": 3,
            "retry_delay": 60,
            "dead_letter_queue": "opencast-notification-poll-prod-staging-dlq"
          },
          {
            "queue": "opencast-notification-poll-prod-staging-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_concurrency": 1,
            "max_retries": 1
          }
        ]
      }
    },
    "production": {
      "name": "your-feed-polling-worker-production",
      "workers_dev": false,
      "preview_urls": false,
      "build": {
        "command": "cargo install -q --locked \"worker-build@0.8.7\" && \"$HOME/.cargo/bin/worker-build\" --release"
      },
      "vars": {
        "NOTIFICATION_ENVIRONMENT": "production",
        // Storage lives in PostgreSQL through the DB Hyperdrive binding. Set the pin
        // to your database's identity, or delete it for an ungated deployment; the
        // REPLACE_WITH_* placeholder does not parse, so an unedited lane refuses
        // every storage call and writes nothing.
        "STORAGE_AUTHORITY": "postgres",
        "STORAGE_IDENTITY": "v1;production;postgres;pg:REPLACE_WITH_DATABASE_NAME:REPLACE_WITH_SYSTEM_IDENTIFIER",
        "NOTIFICATION_DISPATCHER_ADMISSION": "false",
        "NOTIFICATION_FEED_OBSERVATION": "false",
        "NOTIFICATION_FIVE_MINUTE_POLLING": "false",
        "NOTIFICATION_CLEANUP": "false"
      },
      "triggers": {
        "crons": []
      },
      "hyperdrive": [
        {
          "binding": "DB",
          "id": "REPLACE_WITH_PRODUCTION_HYPERDRIVE_ID"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FEED_SNAPSHOTS",
          "bucket_name": "your-feed-snapshots-production"
        }
      ],
      "services": [
        {
          "binding": "NOTIFICATION_EVENTS",
          "service": "your-notifications-worker-production",
          "entrypoint": "FeedEvents"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "POLL_QUEUE",
            "queue": "opencast-notification-poll-production"
          }
        ],
        "consumers": [
          {
            "queue": "opencast-notification-poll-production",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_concurrency": 2,
            "max_retries": 3,
            "retry_delay": 60,
            "dead_letter_queue": "opencast-notification-poll-production-dlq"
          },
          {
            "queue": "opencast-notification-poll-production-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_concurrency": 1,
            "max_retries": 1
          }
        ]
      }
    }
  }
}
