{
  "name": "@opencast/website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "check:help": "node scripts/validate-help.mjs",
    "build": "yarn check:help && next build",
    "sync-screenshots": "node scripts/sync-screenshots.mjs",
    "sync-brand-assets": "node scripts/sync-brand-assets.mjs",
    "preview": "yarn build && wrangler dev",
    "deploy": "yarn sync-screenshots && yarn build && wrangler deploy",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p worker --noEmit"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "catalog:"
  }
}
