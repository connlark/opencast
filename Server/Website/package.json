{
  "name": "@opencast/website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "sync-screenshots": "node scripts/sync-screenshots.mjs",
    "sync-brand-assets": "node scripts/sync-brand-assets.mjs",
    "preview": "next build && wrangler dev",
    "deploy": "yarn sync-screenshots && next build && wrangler deploy",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p worker --noEmit"
  },
  "dependencies": {
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.111.0"
  }
}
