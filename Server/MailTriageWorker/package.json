{
  "name": "opencast-mail-triage-worker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "deploy:dry-run:production": "wrangler deploy --dry-run --outdir dist-production --env production",
    "deploy:production": "wrangler deploy --env production",
    "eval": "node eval/run.mjs",
    "login": "wrangler login",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "postal-mime": "3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "typescript": "^5.9.3",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
