{
  "name": "opencast-remote-transcription-worker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "deploy:dry-run:prod-staging": "wrangler deploy --dry-run --outdir dist-prod-staging --env prod-staging",
    "deploy": "wrangler deploy",
    "deploy:prod-staging": "wrangler deploy --env prod-staging",
    "deploy:production": "wrangler deploy --env production",
    "login": "wrangler login",
    "test": "cargo test",
    "typecheck": "cargo check --target wasm32-unknown-unknown",
    "build:worker": "cargo install -q --locked \"worker-build@0.8.5\" && \"$HOME/.cargo/bin/worker-build\" --release",
    "test:integration": "yarn run build:worker && vitest run",
    "test:production": "yarn run build:worker && vitest run -c vitest.production.config.mjs",
    "test:purchase": "yarn run build:worker && yarn workspace opencast-purchase-worker build:test-bundle && vitest run -c vitest.purchase.config.mjs && vitest run -c vitest.killswitch.config.mjs",
    "provision": "./scripts/provision-dev.sh",
    "provision:production": "./scripts/provision-production.sh"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "jsonwebtoken": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
