{
  "name": "opencast-purchase-worker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "deploy:dry-run:prod-staging": "wrangler deploy --dry-run --outdir dist-prod-staging --env prod-staging",
    "deploy": "wrangler deploy",
    "deploy:prod-staging": "wrangler deploy --env prod-staging",
    "deploy:production": "wrangler deploy --env production",
    "login": "wrangler login",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c vitest.unit.config.mjs",
    "test:integration": "vitest run -c vitest.workerd.config.mjs",
    "test:production": "vitest run -c vitest.production.config.mjs",
    "build:test-bundle": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "jsonwebtoken": "catalog:",
    "typescript": "^5.6.0",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
